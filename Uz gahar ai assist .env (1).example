# n8n environment variables used by the workflow (never commit real values)
NODE_FUNCTION_ALLOW_BUILTIN=crypto
INCIDENT_SHEET_ID=your_google_sheet_id
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Backend: authorized quality-report mail
QUALITY_OFFICER_EMAIL=quality.officer@example-hospital.eg
SMTP_FROM=incident-ai@example-hospital.eg
AUTHORIZED_APPROVERS=quality.officer@example-hospital.eg,quality.lead@example-hospital.eg
APPROVAL_TOKEN=change-me-long-random-string

# Dashboard
DASHBOARD_TOKEN=change-me-another-long-random-string

# Optional LangSmith tracing (no identifiers in traces)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hospital-incident-ai
